# ====================================================================
# Variables de entorno requeridas para el despliegue
# Copie este archivo como .env y complete los valores reales
# IMPORTANTE: Nunca suba el archivo .env al repositorio de codigo
# ====================================================================

# Base de datos MySQL
DB_ROOT_PASSWORD=cambie_esto_por_una_clave_segura
DB_USERNAME=consultorio
DB_PASSWORD=cambie_esto_por_una_clave_segura

# Redis
REDIS_PASSWORD=cambie_esto_por_una_clave_segura

# JWT - Clave en Base64 (minimo 256 bits)
# Generar con: openssl rand -base64 32
JWT_SECRET=cambie_esto_por_una_clave_jwt_segura_en_base64

# Cifrado AES-256 para historia clinica - exactamente 32 bytes en Base64
# Generar con: openssl rand -base64 32
APP_ENCRYPTION_KEY=cambie_esto_por_una_clave_aes256_en_base64
